<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">hotspot.local</domain>
        <domain includeSubdomains="true">sopraent.com</domain>
        <domain includeSubdomains="true">kwatampora.portal.sopraent.com</domain>
        <domain includeSubdomains="true">detectportal.firefox.com</domain>
        <domain includeSubdomains="true">clients3.google.com</domain>
        <domain includeSubdomains="true">connectivitycheck.gstatic.com</domain>
    </domain-config>
</network-security-config>